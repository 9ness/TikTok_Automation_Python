# =============================================================================
# Plantilla de variables de entorno — TikTok_Automation_Python
# -----------------------------------------------------------------------------
# Cómo usar:
#   1) Copia este archivo a `.env` (en la raíz del proyecto).
#   2) Rellena los valores reales. NO commitees `.env` (está en .gitignore).
#   3) `pip install -r requirements.txt` y `streamlit run main.py`.
# =============================================================================


# -----------------------------------------------------------------------------
# OBLIGATORIAS
# -----------------------------------------------------------------------------

# OpenAI — usado por el guionista de Presidentes y por video_remover (Whisper).
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# MiniMax — TTS de los 3 nichos.
MINIMAX_API_KEY=eyJhbGciOi...   # JWT largo
MINIMAX_GROUP_ID=1234567890123456789
MINIMAX_VOICE_ID=voz_final_tiktok_v2   # voz por defecto (Presidentes, inglés)

# Upstash Redis — Pronósticos lee los picks de aquí + configs_store.
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...


# -----------------------------------------------------------------------------
# OPCIONALES
# -----------------------------------------------------------------------------

# Path raíz de assets de **Creator Reward** (Programa 1). Si NO se define,
# src/utils.py escanea las unidades buscando "Mi unidad/NEBULABS_AUTOMATED_TIKTOK/
# TIKTOK_CR/TIKTOK_ASSETS". Solo descomenta para forzar otra ubicación.
# TIKTOK_ROOT_PATH="H:/Mi unidad/NEBULABS_AUTOMATED_TIKTOK/TIKTOK_CR/TIKTOK_ASSETS"

# Path raíz de **TikTok Shop** (Programa 2). HERMANO de TIKTOK_CR (no anidado).
# Si NO se define, src/tiktok_shop/config.py:resolve_shop_root() escanea las
# unidades buscando "Mi unidad/NEBULABS_AUTOMATED_TIKTOK/TIKTOK_SHOP".
# TIKTOK_SHOP_ROOT_PATH="H:/Mi unidad/NEBULABS_AUTOMATED_TIKTOK/TIKTOK_SHOP"

# Override de voz para el nicho Pronósticos (si no se define, se usa el dropdown de la UI).
# Sugeridas: Spanish_Strong-WilledBoy / Spanish_EnergeticBoy / Spanish_PassionateWarrior
# PRONOSTICOS_VOICE_ID=Spanish_Strong-WilledBoy

# Prefijo de keys en Redis (default `betai:`).
# REDIS_PREFIX=betai:

# APIs de stock para Pronósticos (sin ellas se cae a fondo sólido).
# PEXELS_API_KEY=...
# PIXABAY_API_KEY=...


# -----------------------------------------------------------------------------
# TikTok Shop (Programa 2)
# -----------------------------------------------------------------------------
# Atlas Cloud (Seedance image-to-video / reference-to-video) — nombre per doc oficial.
# Si no está, los vídeos AI no se renderizan; el resto del flujo (analyzer,
# strategist, prompts Veo3 / Nano Banana, voz, captions) sí funciona.
# ATLASCLOUD_API_KEY=...
# ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/api/v1   # default — solo override si Atlas cambia URL

# Cloudflare R2 (o S3) — REQUERIDO para tiers Standard/Advanced (subir fotos
# como URL pública para Atlas Cloud). El tier Pro acepta base64 inline y NO
# necesita esto. TODO: implementación pendiente — ver utils/image_url_provider.py.
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=tiktok-shop-photos
# R2_ACCESS_KEY=...
# R2_SECRET_KEY=...

# Gemini para analyzer (foto producto → JSON), strategist (hook + script) y
# directors. El módulo soporta DUAL-KEY con fallback automático:
#
#   GOOGLE_GEMINI_KEY_FREE — proyecto Cloud SIN billing (free tier 20 req/día
#                            con 2.5-flash). Se intenta primero.
#   GOOGLE_GEMINI_KEY_PAID — proyecto Cloud CON billing y límite mensual
#                            (~5€/mes). Solo se usa si FREE devuelve 429.
#
# Si solo defines una de las dos, se usa esa sin fallback. Si no defines
# ninguna, cae a `GOOGLE_GEMINI_KEY` legacy (compartida con Creator Reward
# — NO recomendado en producción para evitar interferencia entre programas).
#
# GOOGLE_GEMINI_KEY_FREE=AIza...   # proyecto sin billing
# GOOGLE_GEMINI_KEY_PAID=AIza...   # proyecto con billing (~5€/mes)

# Voz por defecto del nicho TikTok Shop. Si no está, cae a Spanish_EnergeticBoy.
# TIKTOK_SHOP_VOICE_DEFAULT=Spanish_EnergeticBoy

# Prefijo de keys Redis para TikTok Shop (default `tiktok_shop:`).
# TIKTOK_SHOP_REDIS_PREFIX=tiktok_shop:

# Límite de gasto mensual USD en TikTok Shop. Si se define, el dashboard muestra
# alerta cuando el coste del mes supera el 80%.
# TIKTOK_SHOP_MONTHLY_BUDGET_USD=50


# -----------------------------------------------------------------------------
# LEGADO (no se usa en flujos activos, solo lo lee health_check)
# -----------------------------------------------------------------------------
# GOOGLE_GEMINI_KEY=...
