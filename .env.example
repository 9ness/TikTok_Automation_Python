# =============================================================================
# Plantilla de variables de entorno — TikTok_Automation_Python
# -----------------------------------------------------------------------------
# Cómo usar:
#   1) Copia este archivo a `.env` (en la raíz del proyecto).
#   2) Rellena los valores reales. NO commitees `.env` (está en .gitignore).
#   3) `pip install -r requirements.txt` y `streamlit run main.py`.
# =============================================================================


# -----------------------------------------------------------------------------
# OBLIGATORIAS
# -----------------------------------------------------------------------------

# OpenAI — usado por el guionista de Presidentes y por video_remover (Whisper).
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# MiniMax — TTS de los 3 nichos.
MINIMAX_API_KEY=eyJhbGciOi...   # JWT largo
MINIMAX_GROUP_ID=1234567890123456789
MINIMAX_VOICE_ID=voz_final_tiktok_v2   # voz por defecto (Presidentes, inglés)

# Upstash Redis — Pronósticos lee los picks de aquí + configs_store.
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...


# -----------------------------------------------------------------------------
# OPCIONALES
# -----------------------------------------------------------------------------

# Path raíz de assets (Drive). Si NO se define, src/utils.py escanea las
# unidades del sistema buscando "Mi unidad/NEBULABS_AUTOMATED_TIKTOK/TIKTOK_CR/TIKTOK_ASSETS".
# Solo descomenta si quieres forzar una ubicación distinta.
# TIKTOK_ROOT_PATH="H:/Mi unidad/NEBULABS_AUTOMATED_TIKTOK/TIKTOK_CR/TIKTOK_ASSETS"

# Override de voz para el nicho Pronósticos (si no se define, se usa el dropdown de la UI).
# Sugeridas: Spanish_Strong-WilledBoy / Spanish_EnergeticBoy / Spanish_PassionateWarrior
# PRONOSTICOS_VOICE_ID=Spanish_Strong-WilledBoy

# Prefijo de keys en Redis (default `betai:`).
# REDIS_PREFIX=betai:

# APIs de stock para Pronósticos (sin ellas se cae a fondo sólido).
# PEXELS_API_KEY=...
# PIXABAY_API_KEY=...


# -----------------------------------------------------------------------------
# LEGADO (no se usa en flujos activos, solo lo lee health_check)
# -----------------------------------------------------------------------------
# GOOGLE_GEMINI_KEY=...
