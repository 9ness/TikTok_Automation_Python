# --- Python y Entorno Virtual ---
venv/
__pycache__/
*.pyc

# --- Archivos de Sistema y VS Code ---
.vscode/
.DS_Store

# --- Carpetas de Trabajo (Muy Importante) ---
temp_work/
logs/
# Ignoramos .env porque puede tener rutas personales
.env

# --- Multimedia (Para no llenar GitHub de videos) ---
*.mp4
*.mp3
*.jpg
*.png
*.mov

# Excepción: assets de marca del frontend SÍ se commitean (necesarios
# para que el container web los sirva en /brand/*).
!frontend/public/brand/*.png
!frontend/public/brand/*.jpg
!frontend/public/**/*.svg
# Convención Next.js App Router: app/icon.png genera el favicon automático
# vía Metadata Files. Si no se commitea, producción se queda sin favicon.
!frontend/app/icon.png
!frontend/app/apple-icon.png
!frontend/app/opengraph-image.png
!frontend/app/twitter-image.png

# --- Rutas específicas de tu proyecto (por seguridad) ---
BIBLIOTECA_PRESIDENTES/
BIBLIOTECA_INTRO/
VIDEOS_TERMINADOS/
TIKTOK_ASSETS/

# --- GUIONES GENERADOS (Añade esto) ---
inputs_generados/