# Caddyfile — reverse proxy para TikTok Automation.
#
# Comportamiento:
#   - Si la env var $DOMAIN está vacía (o = ":80"), Caddy escucha en HTTP local.
#   - Si $DOMAIN está set (ej. "tiktok.example.com"), Caddy obtiene cert HTTPS
#     automáticamente vía Let's Encrypt (puertos 80/443 expuestos al host).
#
# Rutas:
#   /api/*       → contenedor api:8000   (REST + Swagger en /api/docs)
#   /ws/*        → contenedor api:8000   (WebSocket /ws/queue, headers Upgrade)
#   /            → contenedor web:3000   (Next.js standalone)

# Todo lo que sirve la app, en un snippet: se usa igual para el sitio de
# siempre y para el nombre público de abajo, y así no hay dos copias que se
# separen con el tiempo.
(app) {
	# `encode` reduce ancho de banda HTTP. El WebSocket pasa intacto.
	encode gzip

	# Endpoints REST + docs
	@api path /api/* /api
	handle @api {
		reverse_proxy api:8000
	}

	# WebSocket de la cola (incluye headers Upgrade automáticamente en
	# Caddy v2 cuando detecta `Connection: upgrade`).
	@ws path /ws/*
	handle @ws {
		reverse_proxy api:8000
	}

	# Claude Chat — backend Agent SDK que corre en el HOST (no en Docker),
	# atado al bridge 172.18.0.1:8765 (solo alcanzable desde la red docker,
	# nunca internet; ufw bloquea el resto). `handle_path` quita el prefijo
	# → el backend recibe /sessions, /chat, etc. `flush_interval -1` permite
	# el streaming SSE del chat sin buffering.
	@cchat path /claude-chat/*
	handle @cchat {
		uri strip_prefix /claude-chat
		reverse_proxy 172.18.0.1:8765 {
			flush_interval -1
		}
	}

	# Frontend Next.js (cualquier otra ruta).
	handle {
		reverse_proxy web:3000
	}

	# Logs de acceso (json en stdout — `docker compose logs caddy`).
	log {
		output stdout
		format json
	}
}

# El sitio de siempre. Con $DOMAIN vacío es ":80" (HTTP), que es por donde
# entra el Tailscale Funnel.
{$DOMAIN} {
	import app
}

# Nombre PÚBLICO con HTTPS propio, sin depender de Tailscale.
#
# `sslip.io` resuelve cualquier `<ip-con-guiones>.sslip.io` a esa IP, así que
# no hay DNS que crear ni dominio que comprar, y Caddy saca el certificado solo
# por el puerto 80 (abierto). Existe porque el Funnel se ha caído dos veces en
# dos días y con él se cae la web entera: el nombre `.ts.net` lo publica
# Tailscale y si deja de publicarlo no resuelve en ningún sitio.
#
# Cuando haya un dominio propio, se cambia esta línea por él y ya está.
#
# OJO: aquí NO va `import app`. Por el Funnel se entra por el portero de
# `juegos-server` (:8090), que pide el código de acceso antes de dejar pasar a
# la app; sirviendo la app directamente, esta URL quedaba abierta a internet.
# Se manda al MISMO portero para que la puerta pública pida lo de siempre. El
# :8091 es un puente de systemd (`juegos-bridge.socket`) hacia su :8090, que
# escucha solo en loopback y desde el contenedor no se alcanza.
{$DOMAIN_PUBLICO:62-238-19-31.sslip.io} {
	encode gzip
	reverse_proxy 172.18.0.1:8091 {
		flush_interval -1
	}
	log {
		output stdout
		format json
	}
}

# NOTA: La web de cliente (nebulabs-media) habla con el FastAPI a través de la
# URL pública existente del box (Tailscale Funnel / el mismo {$DOMAIN}), en la
# ruta /api/*. No hace falta un subdominio dedicado por ahora. Si en el futuro
# se quiere `api.nebulabsmedia.com`, mover el DNS a un proveedor que no haga
# catch-all (p. ej. Cloudflare) y reañadir aquí un bloque reverse_proxy api:8000.
