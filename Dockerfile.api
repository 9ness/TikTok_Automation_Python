# syntax=docker/dockerfile:1.6
#
# Imagen del backend FastAPI. Mantiene la lógica de los pipelines
# (MoviePy, Whisper, MiniMax, Atlas) y expone /api/* + /ws/queue.
#
# Build:
#   docker build -f Dockerfile.api -t tiktok-api:latest .
#
# Run (sin compose):
#   docker run --rm -p 8000:8000 --env-file .env \
#     -v /mnt/drive:/mnt/drive \
#     tiktok-api:latest

FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Sistema: ffmpeg para MoviePy/Whisper/editor, libgomp1 para faster-whisper,
# build-essential ligero para wheels que no traen binarios precompilados.
# Fuentes: dejavu/liberation/noto cubren fallbacks; ttf-mscorefonts-installer
# instala Impact, Arial Black, Verdana, Times, Comic Sans, Trebuchet, Georgia,
# Courier (las que el código hardcodea como C:\Windows\Fonts\*). El paquete
# vive en `contrib` (no en main) y requiere aceptar EULA de Microsoft via
# debconf antes del install.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libgomp1 \
        curl \
        ca-certificates \
        build-essential \
        gcc \
        fontconfig \
        fonts-dejavu \
        fonts-liberation \
        fonts-noto-color-emoji \
    && echo "deb http://deb.debian.org/debian bookworm contrib" > /etc/apt/sources.list.d/contrib.list \
    && apt-get update \
    && echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" \
       | debconf-set-selections \
    && apt-get install -y --no-install-recommends ttf-mscorefonts-installer \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---------------------------------------------------------------------------
# Stage builder — instala deps en un wheelhouse aislado (cache-friendly)
# ---------------------------------------------------------------------------
FROM base AS builder

COPY requirements.txt ./
# Causa del bug previo: `pip install --prefix=/install packaging` veía
# `packaging` ya satisfecho a nivel sistema (lo trae setuptools) y no
# lo instalaba al wheelhouse `/install`. Resultado: silero-vad falla al
# importar `packaging` en runtime porque NO está en /usr/local tras el
# COPY. Fix: `--ignore-installed --upgrade` fuerza la instalación local
# al wheelhouse aunque exista a nivel sistema.
#
# Verificamos al final que `packaging/` exista en /install — si no, el
# build falla aquí con un mensaje claro en lugar de propagarse a runtime.
RUN pip install --upgrade pip wheel setuptools \
    && pip install --prefix=/install --no-cache-dir --upgrade --ignore-installed "packaging>=23.0" \
    && pip install --prefix=/install --no-cache-dir -r requirements.txt \
    && test -d /install/lib/python3.11/site-packages/packaging \
       || (echo "ERROR: packaging no acabó en /install — el COPY al runtime fallará" && exit 1)

# ---------------------------------------------------------------------------
# Stage runtime — copia solo lo necesario
# ---------------------------------------------------------------------------
FROM base AS runtime

# Copia los paquetes Python instalados desde el builder.
COPY --from=builder /install /usr/local

# Smoke test del build: si silero-vad o google-generativeai no importan,
# el build FALLA aquí — mucho mejor que descubrirlo cuando ya se
# encolaron jobs. `packaging` se prueba explícitamente porque su ausencia
# fue causa real de regresión en producción.
RUN python -c "import packaging, packaging.version; print('packaging OK', packaging.__version__)" \
    && python -c "import silero_vad; print('silero_vad OK')" \
    && python -c "import google.generativeai; print('google.generativeai OK')" \
    && python -c "import faster_whisper; print('faster_whisper OK')" \
    && python -c "from googleapiclient.discovery import build; print('google-api-client OK')"

# Código fuente. Solo lo que el módulo API necesita en runtime —
# Streamlit (`main.py`) NO se copia (no se sirve desde Docker).
COPY src ./src
COPY config ./config
COPY assets ./assets

# Carpetas que el runner crea en runtime (cola persiste estado, uploads).
RUN mkdir -p /app/temp_work /app/temp_work/api_uploads

# Usuario no-root.
RUN groupadd --system app && useradd --system --gid app --home /app app \
    && chown -R app:app /app
USER app

EXPOSE 8000

# Healthcheck simple.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

# 1 worker — CRÍTICO: la `JobQueue` es un singleton en memoria del proceso
# Python con threads que dispatchean los jobs. Si hay >1 worker uvicorn,
# cada uno tiene SU PROPIA cola: enqueue puede caer en worker A pero el
# WebSocket conectado al worker B no ve el job nuevo hasta recargar (y a
# veces ni eso). Para soportar multi-worker habría que mover el estado a
# Redis (refactor mayor). Para esta app de un usuario, 1 worker basta.
ENV API_WORKERS=1 \
    API_HOST=0.0.0.0 \
    API_PORT=8000

# `exec` es CRÍTICO: sin él, `sh` queda como PID 1 y NO reenvía el SIGTERM
# que manda docker al recrear el container → uvicorn nunca recibe la señal,
# ignora el graceful shutdown y docker acaba haciéndole SIGKILL al agotar
# `stop_grace_period` (hasta 30 min de deploy colgado). Con `exec`, uvicorn
# reemplaza a `sh` y pasa a ser PID 1 → recibe SIGTERM directo → el lifespan
# drena la cola (instantáneo si no hay jobs) y el proceso sale al momento.
CMD ["sh", "-c", "exec uvicorn src.api.main:app --host ${API_HOST} --port ${API_PORT} --workers ${API_WORKERS} --timeout-graceful-shutdown 1800"]
