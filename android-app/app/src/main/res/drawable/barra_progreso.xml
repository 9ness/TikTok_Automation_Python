<?xml version="1.0" encoding="utf-8"?>
<!-- La barra con el degradado de la marca (cian → violeta), el mismo del
     título "NebulabsAI" de la web. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="@color/borde" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="8dp" />
                <gradient
                    android:startColor="@color/brand_cyan"
                    android:endColor="@color/brand_violet"
                    android:angle="0" />
            </shape>
        </clip>
    </item>
</layer-list>
