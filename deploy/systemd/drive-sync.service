[Unit]
Description=Sincronizar output_local/ → Google Drive (BIBLIOTECA_VIDEOS_TERMINADOS)
After=gdrive-mount.service
Requires=gdrive-mount.service

[Service]
Type=oneshot
User=nebulabsai
Group=nebulabsai
WorkingDirectory=/home/nebulabsai/TikTok_Automation_Python
ExecStart=/home/nebulabsai/TikTok_Automation_Python/deploy/sync_outputs.sh

# Sin restart — el timer se encarga de relanzar
StandardOutput=journal
StandardError=journal
