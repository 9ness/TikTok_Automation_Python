[Unit]
Description=TikTok Automation — GitHub webhook listener (auto-deploy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nebulabsai
Group=nebulabsai
WorkingDirectory=/home/nebulabsai/TikTok_Automation_Python

# El listener lee WEBHOOK_SECRET del .env de la app. Si no está, no arranca.
EnvironmentFile=/home/nebulabsai/TikTok_Automation_Python/.env
Environment="APP_DIR=/home/nebulabsai/TikTok_Automation_Python"

# Python sistema (no venv) — solo necesita stdlib
ExecStart=/usr/bin/python3 /home/nebulabsai/TikTok_Automation_Python/deploy/webhook_listener.py

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening:
# - ProtectSystem=full → /usr, /boot, /etc en read-only para el proceso
# - User=nebulabsai → nunca corre como root
# OJO: NO ponemos NoNewPrivileges=true porque el deploy script lanza sudo
# (setuid) para `systemctl restart tiktok-factory`. NoNewPrivileges bloquea
# todo binario setuid, lo que rompería el restart. La defensa-en-profundidad
# va por sudoers granular: ver /etc/sudoers.d/nebulabsai-deploy creado por
# register_services.sh — solo permite el comando exacto del restart.
ProtectSystem=full

[Install]
WantedBy=multi-user.target
