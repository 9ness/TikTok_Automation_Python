[Unit]
Description=TikTok Automation — GitHub webhook listener (auto-deploy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nebulabsai
Group=nebulabsai
# Grupo supplementary `docker` necesario para que deploy_safe.sh pueda
# correr `docker compose` (acceso al socket /var/run/docker.sock). Sin
# este flag, `usermod -aG docker nebulabsai` solo aplica a NUEVAS shells
# del user — el systemd service usa el group set en arranque del proceso.
SupplementaryGroups=docker
WorkingDirectory=/home/nebulabsai/TikTok_Automation_Python

# El listener lee WEBHOOK_SECRET del .env de la app. Si no está, no arranca.
EnvironmentFile=/home/nebulabsai/TikTok_Automation_Python/.env
Environment="APP_DIR=/home/nebulabsai/TikTok_Automation_Python"

# Python sistema (no venv) — solo necesita stdlib
ExecStart=/usr/bin/python3 /home/nebulabsai/TikTok_Automation_Python/deploy/webhook_listener.py

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening:
# - ProtectSystem=full → /usr, /boot, /etc en read-only para el proceso
# - User=nebulabsai → nunca corre como root
# - NoNewPrivileges=false EXPLÍCITO: el deploy script lanza sudo (setuid)
#   para `systemctl restart tiktok-factory`. NoNewPrivileges=true bloquearía
#   todo binario setuid, lo que rompería el restart. La defensa en
#   profundidad va por sudoers granular: ver /etc/sudoers.d/nebulabsai-deploy
#   creado por register_services.sh — solo permite el comando exacto del
#   restart. NO cambiar este flag a true sin reescribir el flujo de deploy.
NoNewPrivileges=false
ProtectSystem=full

[Install]
WantedBy=multi-user.target
