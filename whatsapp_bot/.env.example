# Bot de WhatsApp del Editor — variables (solo nombres; los valores van con `clave whatsapp-bot <VARIABLE>`).
# `deploy/desplegar.sh --preparar` crea ~/proyectos/whatsapp-bot/.env.local con lo que se puede generar solo.

# ── Proveedor: meta (Cloud API directa, número aparte) | 360dialog (coexistencia con la app del móvil)
WHATSAPP_PROVEEDOR=meta

# ── Meta directo (WhatsApp Manager → API Setup / App → Settings → Basic)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=            # lo genera --preparar; se pega en Meta al configurar el webhook

# ── 360dialog (solo si WHATSAPP_PROVEEDOR=360dialog)
D360_API_KEY=
WHATSAPP_WEBHOOK_SECRETO=         # lo genera --preparar

# ── Servicio
WHATSAPP_URL_PUBLICA=https://factory.nebulabsmedia.com/wa
WHATSAPP_ADMIN_TOKEN=             # lo genera --preparar (panel «Conectar WhatsApp»)
WHATSAPP_INTERNO_TOKEN=           # lo genera --preparar (API del editor → avisos)
WHATSAPP_DB=/home/nebulabsai/whatsapp-bot/datos/whatsapp.db

# ── API del Editor Auto (vps-trabajo, por Tailscale)
EDITOR_API_URL=http://100.96.125.108:8080
EDITOR_API_KEY=                   # la API_KEY de la fábrica (la copia --preparar)

# ── IA (Haiku) para preguntas libres; vacío = solo menús
ANTHROPIC_API_KEY=
WHATSAPP_IA_MAX_DIA=15

# ── Avisos a Néstor (el panel vive en el mismo servidor)
PANEL_URL=http://127.0.0.1:8800
PANEL_TOKEN=

# ── Comportamiento (opcionales)
WHATSAPP_HORARIO=1234567=09:00-22:00      # días ISO (1 = lunes) = tramo; «siempre» = 24 h
WHATSAPP_SILENCIO_MIN=120                 # si Néstor contesta desde el móvil, el bot calla este rato
WHATSAPP_PAUSA_HUMANO_MIN=720             # tras «hablar con Néstor»
WHATSAPP_TOPE_MES=950                     # Meta regala 1.000 mensajes de servicio al mes
WHATSAPP_ENLACE_PAGO=
WHATSAPP_DATOS_PAGO=
WHATSAPP_PLANTILLAS_DE_PAGO=0             # 1 = avisar con plantilla (se cobra) fuera de la ventana de 24 h
